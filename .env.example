# Copy this file to `.env` and fill it in. `.env` is git-ignored; keys stay on the server and are never sent to the browser.
# Restart the dev server after changing it. On Vercel, set the same names under Project Settings -> Environment Variables
# (`.env` is not deployed).

# --- AI DJ, cloud voice (recommended) ---------------------------------------------------------------------------------
# Natural Deepgram Aura-2 voices. Free: sign up at https://console.deepgram.com and you get $200 of credit that does not
# expire and needs no credit card. One announcement is ~100 characters (about a quarter of a cent), so that is tens of
# thousands of announcements.
DEEPGRAM_API_KEY=

# --- AI DJ, livelier wording (optional) -------------------------------------------------------------------------------
# Any OpenAI-compatible chat endpoint. Groq has a free tier with generous limits and no card: https://console.groq.com
# Without it the DJ uses its built-in sentences. One request returns three versions and they are reused, so it needs
# roughly one request per three announcements.
WORDING_API_KEY=
# WORDING_BASE_URL=https://api.groq.com/openai/v1
# WORDING_MODEL=llama-3.1-8b-instant

# --- Public deployment (Vercel) ---------------------------------------------------------------------------------------
# The cloud voice spends your Deepgram credit, so on a public URL it must not be open to everyone. In production the DJ
# endpoints are LOCKED unless this is set; visitors then type the code once into the AI DJ card (kept in their browser).
# Pick a long random string. Not needed when running locally.
DJ_ACCESS_CODE=
# Escape hatch (not recommended): leave the DJ endpoints open in production.
# DJ_ALLOW_OPEN=1
# The YouTube / SoundCloud URL import only runs locally; it does not work on Vercel. Force it on in production:
# ENABLE_URL_IMPORT=1
